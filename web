#!/bin/bash

WEB_DIR=${BASH_SOURCE%/*}
WEB_BOOKMARKS="${WEB_BOOKMARKS:-$WEB_DIR/json/bookmarks.json}"
WEB_CONF="${WEB_CONF:-$WEB_DIR/json/conf.json}"
WEB_BROWSERS="${WEB_BROWSERS:-$WEB_DIR/json/browser.json}"
WEB_ENGINES="${WEB_ENGINES:-$WEB_DIR/json/engines.json}"

web() {
    if ! command -v jq &> /dev/null; then
        echo "Error: 'jq' is required but not found."
        return 1
    fi 
    for f in "$WEB_BOOKMARKS" "$WEB_CONF" "$WEB_BROWSERS" "$WEB_ENGINES"; do
        if [[ ! -f "$f" ]]; then
            mkdir -p "$(dirname "$f")"
            printf '{}\n' >"$f"
        elif [[ ! -s "$f" ]]; then
            printf '{}\n' >"$f"
        fi
    done

    function load_config() {
        WEB_BROWSER=$(jq -r '.default.browser // empty' "$WEB_CONF")
        WEB_ENGINE=$(jq -r '.default.search // empty' "$WEB_CONF")

        declare -gA WEB_browser_cmd

        local browser
        for browser in $(jq -r 'keys[]' "$WEB_BROWSERS"); do
            WEB_browser_cmd[$browser,cmd]=$(jq -r --arg b "$browser" '.[$b].cmd // empty' "$WEB_BROWSERS")
            WEB_browser_cmd[$browser,private]=$(jq -r --arg b "$browser" '.[$b].private // empty' "$WEB_BROWSERS")
            WEB_browser_cmd[$browser,profile]=$(jq -r --arg b "$browser" '.[$b].profile // empty' "$WEB_BROWSERS")
        done

        WEB_protocols=($(jq -r '.protocol | keys[]' "$WEB_CONF" 2>/dev/null))
    }

    function print_help(){
        echo "
USAGE:
  web [command] [arguments]

COMMANDS:
  -a, --add bookmark_name url private(true/false) profile_name
      Add a new bookmark with specified details.

  -s, --search [engine] search_term
      Search using a specific engine or default engine if none is specified.

  -l, --list [category]
      List items based on category:
          b, book, bookmarks - List all bookmarks.
          p, prot, protocols - List supported protocols.
          B, brow, browsers  - List supported browsers.
          s, src,  sources   - List available search engines.

  [url]
      Open the specified URL directly.
    
ALIASES:
  wb             = web
  wb ls[b/p/B,s] = web ls bookmarks/protocols/browsers/sources
    "
    }

    function validate_protocol() {
        local url="$1"
        local protocol=${url%%:*}

        local accepted_protocols=(http https)

        local protocol_list
        protocol_list=$(jq -r '
          .protocol
          | to_entries
          | map(select(.value == true))
          | .[].key
        ' "$WEB_CONF" 2>/dev/null)

        if [[ -n "$protocol_list" ]]; then
            IFS=$'\n' read -r -d '' -a accepted_protocols <<<"$protocol_list"$'\0'
        fi

        local proto
        for proto in "${accepted_protocols[@]}"; do
            if [[ "$proto" == "$protocol" ]]; then
                return 0
            fi
        done

        echo "Protocol '$protocol' is not accepted."
        return 1
    } 

    function add_bookmark() {
        local full_name="$1"
        local url="$2"
        local private="${3:-false}"
        local profile="${4:-}"

        if ! validate_protocol "$url"; then
            return 1
        fi

        # Write bookmark using jq setpath
        local tmp
        tmp=$(mktemp)

        if ! jq --arg ns "$full_name" \
                --arg url "$url" \
                --arg profile "$profile" \
                --arg private "$private" '
            . as $root
            | ($ns | split(":")) as $p
            | ($private == "true") as $pvt
            | setpath($p + ["url"]; $url)
            | setpath($p + ["private"]; $pvt)
            | setpath($p + ["profile"]; $profile)
        ' "$WEB_BOOKMARKS" >"$tmp" 2>/dev/null; then
            rm -f "$tmp"
            return 1
        fi

        mv "$tmp" "$WEB_BOOKMARKS"

        echo "Bookmark '$full_name' added:"
        echo "url = '$url'"
        echo "private = '$private'"
        echo "profile = '$profile'"
    }

    function remove_bookmark() {
        local force_remove=false
        local bookmark

        if [[ "$1" == "-f" || "$1" == "--force" ]]; then
            force_remove=true
            shift
        fi
        bookmark="$1"

        if [[ -z "$bookmark" ]]; then
            echo "No bookmark specified to remove."
            return 1
        fi

        local is_namespace
        is_namespace=$(jq -r --arg ns "$bookmark" '
            ($ns | split(":")) as $p
            | (try (getpath($p) | type) catch empty)
        ' "$WEB_BOOKMARKS")

        if [[ "$is_namespace" == "object" && $force_remove == false ]]; then
            echo "Error: '${bookmark}' is a namespace. Use '--force' to remove it."
            return 1
        fi

        local tmp
        tmp=$(mktemp)

        if ! jq --arg ns "$bookmark" '
            ($ns | split(":")) as $p
            | delpaths([$p])
        ' "$WEB_BOOKMARKS" >"$tmp" 2>/dev/null; then
            rm -f "$tmp"
            return 1
        fi

        mv "$tmp" "$WEB_BOOKMARKS"

        if $force_remove; then
            echo "Namespace '$bookmark' removed."
        else
            echo "Bookmark '$bookmark' removed."
        fi
    } 

    function open_url() {
        local url="$1"
        local private="$2"
        local profile="$3"

        if ! validate_protocol "$url"; then
            return 1
        fi

        if [[ -z "$WEB_BROWSER" ]]; then
            if command -v xdg-open &> /dev/null; then
                xdg-open "$url" & disown
                return 0
            else
                echo "No valid browser or xdg-open available."
                return 1
            fi
        fi

        local cmd="${WEB_browser_cmd[$WEB_BROWSER,cmd]}"
        local options=""

        if [[ "$private" == "true" ]]; then
            options+=" ${WEB_browser_cmd[$WEB_BROWSER,private]}"
        fi

        if [[ -n "$profile" && "$profile" != "null" ]]; then
            options+=" ${WEB_browser_cmd[$WEB_BROWSER,profile]} \"$profile\""
        fi

        if [[ -z "$cmd" ]]; then
            echo "No valid browser command found for $WEB_BROWSER."
            return 1
        fi

        local full_cmd="$cmd $options \"$url\""
        eval "$full_cmd & disown"
    } 

    function open_bookmark() {
        local combined_name="$*"
        local ns path_arg

        # Accept either ":"-separated or space-separated namespaces
        if [[ "$combined_name" == *":"* ]]; then
            ns="$combined_name"
        else
            ns="${combined_name// /:}"
        fi

        local url private profile

        url=$(jq -r --arg ns "$ns" '
            ($ns | split(":")) as $p
            | (try getpath($p) catch null) as $bm
            | if $bm == null then empty else $bm.url // empty end
        ' "$WEB_BOOKMARKS")

        if [[ -z "$url" ]]; then
            echo "No bookmark found for '$combined_name'."
            return 1
        fi

        private=$(jq -r --arg ns "$ns" '
            ($ns | split(":")) as $p
            | (try getpath($p) catch null) as $bm
            | if $bm == null then "false" else ($bm.private // false | tostring) end
        ' "$WEB_BOOKMARKS")

        profile=$(jq -r --arg ns "$ns" '
            ($ns | split(":")) as $p
            | (try getpath($p) catch null) as $bm
            | if $bm == null then "" else ($bm.profile // "") end
        ' "$WEB_BOOKMARKS")

        open_url "$url" "$private" "$profile"
    }    

    function search_term() {
        local source="$1"
        local term="$2"

        if [[ -z "$term" ]]; then
            term="$source"
            source="${WEB_ENGINE:-duckduckgo}"
        fi

        local base_url
        base_url=$(jq -r --arg src "$source" '
            [ .[] | .[$src]? | select(. != null) | .url ][0] // empty
        ' "$WEB_ENGINES")

        if [[ -z "$base_url" || "$base_url" == "null" ]]; then
            echo "No search engine found for '$source'."
            return 1
        fi

        local search_url="${base_url//...}${term// /+}"
        eval "${WEB_browser_cmd[$WEB_BROWSER,cmd]} \"$search_url\" & disown"
    }

    function list_bookmarks() { 
        echo "Bookmarks:"
        echo "-----------"
        jq '.' "$WEB_BOOKMARKS"
    }

    function list_protocols() {
        echo "Protocols:"
        echo "-----------"
        local protocol
        for protocol in "${WEB_protocols[@]}"; do
            echo "- $protocol"
        done
    }

    function list_browsers() {
        echo "Browsers:"
        echo "-----------"
        jq -r 'keys[]' "$WEB_BROWSERS" | sed 's/^/- /'
    }

    function list_search_sources() {
        echo "Search Engines:"
        echo "----------------"
        local namespace engine
        for namespace in $(jq -r 'keys[]' "$WEB_ENGINES"); do
            for engine in $(jq -r --arg ns "$namespace" '.[$ns] | keys[]' "$WEB_ENGINES"); do
                echo "- ${namespace}.${engine}"
            done
        done
    }

    if [[ -z "$WEB_BROWSER" ]]; then
        load_config
    fi

    if [[ -z "$1" ]]; then
        print_help
        return
    fi

    if [[ "$1" =~ ^(https?|ssh):// ]]; then
        open_url "$1"
        return
    fi

    case "$1" in
        -h|--help|help)
            print_help ;;
        -a|--add|add)
            if [[ -n "$2" ]]; then
                shift 1
                add_bookmark "$@"
            else
                echo "Usage: web -a bookmark_name url private(optional, bool) profile_name(optional)"
            fi
            ;;
        -r|--remove|rm)
            if [[ -n "$2" ]]; then
                shift 1
                remove_bookmark "$@"
            else
                echo "Usage: web -r bookmark_name or web -r -f namespace"
            fi
            ;;
        -s|--search|search)
            load_config
            search_term "$2" "$3"
            ;;
        -l|--list|list|ls)
            case "$2" in
                book|bookmarks|b)
                    list_bookmarks ;;
                prot|protocol|protocols|p)
                    list_protocols ;;
                browser|browsers|B)
                    list_browsers ;;
                source|src|s)
                    list_search_sources ;;
                *)
                    echo "Invalid list option. Use b/bookmarks, p/protocols, B/browsers, or s/sources." ;;
            esac
            ;;
        lsb)
            list_bookmarks ;;
        lsp)
            list_protocols ;;
        lsB)
            list_browsers ;;
        lse|lss)
            list_search_sources ;;
        *)
            load_config
            open_bookmark "$@"
            ;;
    esac
}

_web_complete() {
    local cur prev opts bookmarks_list engines_list

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="--add --list --search --remove"
    cats="bookmarks protocols browsers engines"

    if [[ -f "$WEB_BOOKMARKS" ]]; then
        bookmarks_list=$(jq -r 'keys[]?' "$WEB_BOOKMARKS" 2>/dev/null | tr '\n' ' ')
    fi

    if [[ -f "$WEB_ENGINES" ]]; then
        engines_list=$(jq -r 'to_entries[] | .value | keys[]?' "$WEB_ENGINES" 2>/dev/null | tr '\n' ' ')
    fi

    _bookmark_children() {
        local cword_index=$1
        local -a tokens
        local i
        local token
        local jq_path=""

        if [[ $cword_index -le 1 ]]; then
            echo "$bookmarks_list"
            return
        fi

        local count=$((cword_index - 1))
        tokens=("${COMP_WORDS[@]:1:count}")

        local -a parts
        for i in "${!tokens[@]}"; do
            token="${tokens[i]}"
            token="${token//:/.}"
            parts+=("$token")
        done

        local IFS='.'
        jq_path="${parts[*]}"

        if [[ -n "$jq_path" ]]; then
            jq -r --arg p "$jq_path" '
                if $p == "" then
                    keys[]?
                else
                    ($p | split(".")) as $path
                    | (try getpath($path) catch {})
                    | keys[]?
                end
            ' "$WEB_BOOKMARKS" 2>/dev/null | tr '\n' ' '
        else
            jq -r 'keys[]?' "$WEB_BOOKMARKS" 2>/dev/null | tr '\n' ' '
        fi
    }

    case "${prev}" in
        web|w)
            if [[ "$cur" == -* || "$cur" == "" ]]; then
                COMPREPLY=( $(compgen -W "$opts $bookmarks_list" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "$bookmarks_list" -- "$cur") )
            fi
            ;;
        -l|--list|list)
            COMPREPLY=( $(compgen -W "$cats" -- "$cur") )
            ;;
        -r|--remove|rm)
            COMPREPLY=( $(compgen -W "$bookmarks_list" -- "$cur") )
            ;;
        -s|--search|search)
            COMPREPLY=( $(compgen -W "$engines_list" -- "$cur") )
            ;;
        *)
            if [[ "${COMP_WORDS[0]}" == "web" || "${COMP_WORDS[0]}" == "w" ]]; then
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
                    return 0
                fi
                local children
                children="$(_bookmark_children "$COMP_CWORD")"
                if [[ -n "$children" ]]; then
                    COMPREPLY=( $(compgen -W "$children" -- "$cur") )
                else
                    COMPREPLY=( $(compgen -W "$bookmarks_list" -- "$cur") )
                fi
            fi
            ;;
    esac
}

complete -F _web_complete web
complete -F _web_complete w

alias w="web"
